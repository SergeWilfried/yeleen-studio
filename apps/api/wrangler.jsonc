{
  // API du studio (Worker + Durable Object + R2). Déploiement : `pnpm deploy:api` (racine), ou la construction Git de Cloudflare
  // avec ce dossier comme racine (commande de build : `pnpm run build`, de déploiement : `npx wrangler deploy`).
  // Ce fichier est en .jsonc comme celui de la racine (le site) : wrangler 4 prend le fichier .jsonc le plus proche, et un
  // wrangler.toml ici serait ignoré au profit de celui de la racine, qui publierait le site à la place de l'API.
  "name": "yeleen-studio-backend",
  "main": "src/index.js",
  "compatibility_date": "2024-10-01",

  // Valeurs de production. En local, `.dev.vars` les remplace (ENV=dev offre des jetons de test).
  // ALLOWED_ORIGINS (origines du site, séparées par des virgules) est écrit ici : la construction Git de Cloudflare lance un simple
  // `wrangler deploy`, sans `--var`, et sans cette valeur le navigateur refuse toutes les réponses de l'API (CORS). Ajouter ici un
  // domaine personnalisé du site ; `scripts/deploy.mjs` la remplace à la commande.
  // CLERK_ISSUER (adresse de l'instance Clerk) se règle dans Cloudflare (Variables et secrets) ou à la commande ; `keep_vars` empêche
  // un déploiement d'effacer ce qui est réglé dans le tableau de bord (sauf les variables écrites ici, qui l'emportent).
  // FAL_KEY est un secret : `wrangler secret put FAL_KEY` ou le tableau de bord, jamais ici.
  // Recharges (paygate) : PAYGATE_URL (variable), PAYGATE_KEY et PAYGATE_WEBHOOK_SECRET (secrets), TOPUP_COUNTRIES (« BF » par défaut).
  "vars": { "ENV": "production", "ALLOWED_ORIGINS": "https://yeleen-studio.labsprogiciel.workers.dev" },
  "keep_vars": true,

  // Compte : portefeuille de jetons et générations, un Durable Object par compte (un seul écrivain, pas de double débit).
  "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],

  // Fichiers générés. En local, `wrangler dev` simule le bucket. En production, le bucket doit exister :
  // `wrangler r2 bucket create studio-files` (scripts/deploy.mjs le crée).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "studio-files" }],

  // Base D1 : les utilisateurs (profil, pays, date d'arrivée), liés à Clerk par `sub`. Le portefeuille et les générations restent dans le
  // Durable Object. Créer la base : `pnpm exec wrangler d1 create yeleen` (scripts/deploy.mjs le fait), puis remplacer database_id ci-dessous
  // par l'identifiant affiché (le script le remplace lui-même) et le valider dans git. Migrations : dossier `migrations/`.
  "d1_databases": [{ "binding": "DB", "database_name": "yeleen", "database_id": "4aecfcb9-7cd4-4eae-aaad-1822ee3706a3", "migrations_dir": "migrations" }],

  // À activer quand les ressources existent :
  
  // "queues": { "producers": [{ "binding": "MONTAGE_QUEUE", "queue": "studio-montage" }] },
  // Secrets : FAL_KEY, PAYGATE_KEY, PAYGATE_WEBHOOK_SECRET, WEBHOOK_SECRET (fal)

 "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
