# Copiez ce fichier en .dev.vars (ignoré par git) et renseignez la clé. Ne la mettez jamais dans apps/web.
FAL_KEY=
# Clé Runware (https://my.runware.ai) : Seedance 2.5, Kling 3.0 et Veo 3.1 Lite passent par Runware. Sans elle, ils sont refusés (503).
RUNWARE_KEY=
ENV=dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
MAX_JOB_COST=150
# Connexion Clerk : laissez vide pour développer sans compte (un compte « demo » unique). Renseignez l'adresse de votre instance
# (ex. https://xxx.clerk.accounts.dev) pour tester la vraie garde : alors chaque requête exige un jeton de session.
CLERK_ISSUER=
# Jetons offerts une seule fois à chaque nouvel utilisateur (0 = aucun). Décision de produit : de l'argent réel part avec.
WELCOME_JETONS=
# Recharges Mobile Money (paygate). Utilisez le tenant « sandbox » de paygate, jamais le tenant de production ici.
# Sans PAYGATE_URL et PAYGATE_KEY, /topups répond 503. Le secret du webhook vérifie la signature de /webhooks/payments.
PAYGATE_URL=
PAYGATE_KEY=
PAYGATE_WEBHOOK_SECRET=
# Pays ouverts à la recharge (BF, CI, SN), et adresse https de retour pour Wave (sinon la première origine https + /recharge/retour).
TOPUP_COUNTRIES=BF
TOPUP_RETURN_URL=
